# Using Dynamic Programming

# Step 1: Take two sequences as input
X = input("Enter first sequence: ")
Y = input("Enter second sequence: ")

# Step 2: Find lengths of the sequences
m = len(X)
n = len(Y)

# Step 3: Create DP table
dp = [[0] * (n + 1) for _ in range(m + 1)]

# Step 4: Fill the DP table
for i in range(1, m + 1):
    for j in range(1, n + 1):

        if X[i - 1] == Y[j - 1]:
            dp[i][j] = dp[i - 1][j - 1] + 1
        else:
            dp[i][j] = max(dp[i - 1][j], dp[i][j - 1])

# Step 5: Find the LCS sequence
i = m
j = n
lcs = ""

while i > 0 and j > 0:
    if X[i - 1] == Y[j - 1]:
        lcs = X[i - 1] + lcs
        i -= 1
        j -= 1
    elif dp[i - 1][j] > dp[i][j - 1]:
        i -= 1
    else:
        j -= 1

# Step 6: Display the result
print("Longest Common Subsequence:", lcs)
print("Length of LCS:", len(lcs))